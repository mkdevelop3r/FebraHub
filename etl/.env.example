# A SERVICE_ROLE key IGNORA toda a RLS. Ela só existe aqui,
# no servidor. Nunca no front, nunca no Netlify, nunca commitada.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# Salesforce API (External Client App / Client Credentials)
# Alternativa sem acesso administrativo: URL gerada por `sf org display --verbose`.
SALESFORCE_AUTH_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_INSTANCE_URL=https://sua-instancia.my.salesforce.com
SALESFORCE_UNIDADE=FEBRACIS SALVADOR 2
SALESFORCE_LOOKBACK_DAYS=120

SYMPLA_TOKEN=

CISPAY_API_KEY=
CISPAY_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
